# Copy to .env.local for local development. Supabase is required; the
# analytics and error-reporting values are optional (without them, both are off).

# PostHog (product analytics). Project API key from PostHog > Project settings.
NEXT_PUBLIC_POSTHOG_KEY=
# Only if the PostHog project is in the EU region (read at build time):
# POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# Sentry (errors and cron monitoring). DSN from Sentry > Project settings > Client keys.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for uploading source maps:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Supabase > Project Settings > Data API and > API Keys. Both are public.
NEXT_PUBLIC_SUPABASE_URL=https://tiwfdaarzjxmzwtmvslj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_-lnxSL5Mc5lZRFFIDIKQbQ_qTPsyrct
# Secret: server only. Set it in Vercel, never in a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# The production address, used in invite links. On Vercel it defaults to the
# project's production domain (previews too, as they share the database);
# locally, http://localhost:3000.
# Set in Vercel only; leave unset locally so links point at localhost.
# SITE_URL=https://benvolio.app
