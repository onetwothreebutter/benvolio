# Copy to .env.local for local development. Every value is optional: without
# them, analytics and error reporting are simply switched off.

# PostHog (product analytics). Project API key from PostHog > Project settings.
NEXT_PUBLIC_POSTHOG_KEY=
# Only if the PostHog project is in the EU region:
# POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# Sentry (errors and cron monitoring). DSN from Sentry > Project settings > Client keys.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for uploading source maps:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
